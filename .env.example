# ==============================================================================
# NX502 <- mitmproxy TCP 監視システム  環境変数テンプレート
# ------------------------------------------------------------------------------
# 使い方:
#   cp .env.example .env
#   docker compose up -d
#   docker compose logs -f mitmproxy
# ==============================================================================

# ---- ネットワーク設定 --------------------------------------------------------
# ホストマシン (Ubuntu 24.04 / WSL2) の IP アドレス
HOST_IP=192.168.250.100

# QEMU ゲスト (NX502 エミュレータ) の IP アドレス
GUEST_IP=192.168.250.101

# ---- mitmproxy リッスン設定 --------------------------------------------------
# mitmproxy がバインドするホスト側アドレス (0.0.0.0 = 全 IF)
MITM_LISTEN_HOST=0.0.0.0

# mitmproxy がリッスンする TCP ポート (NX502 接続先)
MITM_LISTEN_PORT=9999

# ---- タイムゾーン / その他 ---------------------------------------------------
TZ=Asia/Tokyo
